apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: argocd-server
  namespace: {{ argocd_namespace }}
  labels:
    app.kubernetes.io/name: argocd-server
    app.kubernetes.io/part-of: argocd
  annotations:
    cert-manager.io/cluster-issuer: {{ argocd_cluster_issuer }}
    # Traefik: talk HTTP to ArgoCD after server.insecure=true
    traefik.ingress.kubernetes.io/service.serversscheme: http
spec:
  ingressClassName: {{ argocd_ingress_class }}
  tls:
    - hosts:
        - {{ argocd_host }}
      secretName: {{ argocd_tls_secret }}
  rules:
    - host: {{ argocd_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: argocd-server
                port:
                  number: 80
