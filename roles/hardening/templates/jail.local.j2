# Managed by Ansible (hardening role)
# Overrides /etc/fail2ban/jail.conf

[DEFAULT]
bantime  = {{ hardening_fail2ban_bantime }}
findtime = {{ hardening_fail2ban_findtime }}
maxretry = {{ hardening_fail2ban_maxretry }}
backend  = systemd

[sshd]
enabled  = true
port     = {{ hardening_fail2ban_ssh_port }}
filter   = sshd
logpath  = /var/log/auth.log
maxretry = {{ hardening_fail2ban_maxretry }}
